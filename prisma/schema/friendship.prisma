enum FriendshipStatus {
  pending
  accepted
}

model Friendship {
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
  @@index([addresseeId])
}

model SuggestionDismissal {
  userId          Int
  dismissedUserId Int
  dismissedAt     DateTime @default(now())
  user            User     @relation("SuggestionDismissals", fields: [userId], references: [id], onDelete: Cascade)
  dismissedUser   User     @relation("DismissedSuggestions", fields: [dismissedUserId], references: [id], onDelete: Cascade)

  @@id([userId, dismissedUserId])
  @@index([dismissedUserId])
}
