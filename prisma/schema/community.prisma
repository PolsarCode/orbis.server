model Community {
  id                     Int                     @id @default(autoincrement())
  name                   String
  description            String?
  iconUrl                String?
  coverUrl               String?
  backgroundUrl          String?
  twitchUserId           String?
  twitchLogin            String?
  showTwitchLive         Boolean                 @default(true)
  showTwitchClips        Boolean                 @default(true)
  discordGuildId         String?
  discordGuildName       String?
  showDiscordOnline      Boolean                 @default(true)
  showDiscordInvite      Boolean                 @default(true)
  links                  Json                    @default("{}")
  ownerId                Int
  isPublic               Boolean                 @default(false)
  isVerified             Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  owner                  User                    @relation(fields: [ownerId], references: [id])
  memberships            Membership[]
  roles                  Role[]
  posts                  Post[]
  comments               Comment[]
  invites                Invite[]
  discordChannel         DiscordChannel?
  discordCharts          DiscordChartChannel?
  discordChartPosts      DiscordChartPost[]
  forumSections          ForumSection[]
  bans                   CommunityBan[]
  forumCategories        ForumCategory[]
  forumThreads           ForumThread[]
  forumPosts             ForumPost[]
  reposts                Repost[]
  facebookMilestonePosts FacebookMilestonePost[]

  @@index([ownerId])
}

model Membership {
  userId             Int
  communityId        Int
  nickname           String?
  showLibraryUpdates Boolean          @default(true)
  position           Int              @default(0)
  folderId           Int?
  joinedAt           DateTime         @default(now())
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  community          Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  folder             RailFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  roles              MembershipRole[]

  @@id([userId, communityId])
  @@index([communityId])
  @@index([folderId])
}

model RailFolder {
  id          Int          @id @default(autoincrement())
  userId      Int
  name        String?
  color       String?
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([userId])
}

model Role {
  id          Int              @id @default(autoincrement())
  communityId Int
  name        String
  permissions BigInt           @default(0)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     MembershipRole[]

  @@unique([id, communityId])
  @@index([communityId])
}

model MembershipRole {
  userId      Int
  communityId Int
  roleId      Int
  membership  Membership @relation(fields: [userId, communityId], references: [userId, communityId], onDelete: Cascade)
  role        Role       @relation(fields: [roleId, communityId], references: [id, communityId], onDelete: Cascade)

  @@id([userId, communityId, roleId])
  @@index([roleId])
}

model Invite {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  communityId Int
  creatorId   Int
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  permanent   Boolean   @default(false)
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([creatorId])
}

model DiscordChannel {
  communityId  Int              @id
  webhookId    String
  webhookToken String
  guildId      String
  guildName    String?
  channelId    String
  isForum      Boolean          @default(false)
  sendPosts    Boolean          @default(true)
  sendLibrary  Boolean          @default(true)
  lostAt       DateTime?
  createdAt    DateTime         @default(now())
  community    Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages     DiscordMessage[]
}

model DiscordMessage {
  id          Int             @id @default(autoincrement())
  communityId Int
  targetType  CommentableType
  targetId    Int
  messageId   String
  threadId    String?
  createdAt   DateTime        @default(now())
  channel     DiscordChannel  @relation(fields: [communityId], references: [communityId], onDelete: Cascade)

  @@unique([communityId, targetType, targetId])
  @@index([targetType, targetId])
}

model DiscordChartChannel {
  communityId  Int       @id
  webhookId    String
  webhookToken String
  guildId      String
  guildName    String?
  channelId    String
  isForum      Boolean   @default(false)
  sendAnime    Boolean   @default(false)
  sendManga    Boolean   @default(false)
  sendGames    Boolean   @default(false)
  message      String?   @db.VarChar(500)
  lostAt       DateTime?
  createdAt    DateTime  @default(now())
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model DiscordChartPost {
  communityId Int
  mediaType   MediaType
  week        String
  messageId   String?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([communityId, mediaType, week])
}

model CommunityBan {
  communityId Int
  userId      Int
  bannedById  Int?
  reason      String?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation("CommunityBans", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy    User?     @relation("CommunityBansIssued", fields: [bannedById], references: [id], onDelete: SetNull)

  @@id([communityId, userId])
  @@index([userId])
  @@index([bannedById])
}
