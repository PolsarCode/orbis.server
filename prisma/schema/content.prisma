enum CommentableType {
  post
  activity
}

enum LikeableType {
  post
  activity
  comment
}

model Post {
  id            Int        @id @default(autoincrement())
  communityId   Int?
  wallUserId    Int?
  mediaType     MediaType?
  mediaSourceId String?
  authorId      Int
  content       String
  linkUrl       String?
  commentCount  Int        @default(0)
  likeCount     Int        @default(0)
  hiddenAt      DateTime?
  editedAt      DateTime?
  pinnedAt      DateTime?
  createdAt     DateTime   @default(now())
  community     Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  wallUser      User?      @relation("WallPosts", fields: [wallUserId], references: [id], onDelete: Cascade)
  author        User       @relation(fields: [authorId], references: [id])

  @@index([communityId, createdAt(sort: Desc)])
  @@index([wallUserId, createdAt(sort: Desc)])
  @@index([mediaType, mediaSourceId, createdAt(sort: Desc)])
}

model Comment {
  id              Int             @id @default(autoincrement())
  communityId     Int?
  commentableType CommentableType
  commentableId   Int
  parentId        Int?
  authorId        Int
  content         String
  linkUrl         String?
  likeCount       Int             @default(0)
  hiddenAt        DateTime?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  community       Community?      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author          User            @relation(fields: [authorId], references: [id])
  parent          Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]       @relation("CommentReplies")

  @@index([commentableType, commentableId, createdAt])
  @@index([parentId])
}

model Like {
  userId       Int
  likeableType LikeableType
  likeableId   Int
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, likeableType, likeableId])
  @@index([likeableType, likeableId])
}
