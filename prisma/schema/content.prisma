enum CommentableType {
  post
  activity
  chart
}

enum LikeableType {
  post
  activity
  comment
  forum_post
}

enum BookmarkableType {
  post
}

model Post {
  id                   Int              @id @default(autoincrement())
  communityId          Int?
  wallUserId           Int?
  mediaType            MediaType?
  mediaSourceId        String?
  isAdult              Boolean          @default(false)
  authorId             Int
  content              String
  linkUrl              String?
  spoiler              String?
  commentCount         Int              @default(0)
  likeCount            Int              @default(0)
  hiddenAt             DateTime?
  editedAt             DateTime?
  pinnedAt             DateTime?
  forumThreadId        Int?             @unique
  isQuote              Boolean          @default(false)
  quotePostId          Int?
  quoteActivityId      Int?
  createdAt            DateTime         @default(now())
  community            Community?       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  wallUser             User?            @relation("WallPosts", fields: [wallUserId], references: [id], onDelete: Cascade)
  author               User             @relation(fields: [authorId], references: [id])
  forumThread          ForumThread?     @relation(fields: [forumThreadId], references: [id], onDelete: Cascade)
  quotePost            Post?            @relation("PostQuotes", fields: [quotePostId], references: [id], onDelete: SetNull)
  quoteActivity        LibraryActivity? @relation(fields: [quoteActivityId], references: [id], onDelete: SetNull)
  quotes               Post[]           @relation("PostQuotes")
  reposts              Repost[]
  hashtagUsages        HashtagUsage[]   @relation("PostHashtags")
  commentHashtagUsages HashtagUsage[]   @relation("PostCommentHashtags")
  editVersions         EditVersion[]

  @@index([communityId, createdAt(sort: Desc)])
  @@index([wallUserId, createdAt(sort: Desc)])
  @@index([mediaType, mediaSourceId, createdAt(sort: Desc)])
  @@index([quotePostId, createdAt(sort: Desc)])
  @@index([quoteActivityId, createdAt(sort: Desc)])
}

model Repost {
  id          Int              @id @default(autoincrement())
  userId      Int
  postId      Int?
  activityId  Int?
  communityId Int?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  activity    LibraryActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  community   Community?       @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, activityId])
  @@index([postId, createdAt(sort: Desc)])
  @@index([activityId, createdAt(sort: Desc)])
  @@index([communityId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model Comment {
  id              Int             @id @default(autoincrement())
  communityId     Int?
  commentableType CommentableType
  commentableId   Int
  parentId        Int?
  authorId        Int?
  content         String
  linkUrl         String?
  spoiler         String?
  likeCount       Int             @default(0)
  hiddenAt        DateTime?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  community       Community?      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author          User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent          Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]       @relation("CommentReplies")
  hashtagUsages   HashtagUsage[]
  editVersions    EditVersion[]

  @@index([commentableType, commentableId, createdAt])
  @@index([parentId])
}

model EditVersion {
  id          Int        @id @default(autoincrement())
  postId      Int?
  commentId   Int?
  forumPostId Int?
  content     String
  linkUrl     String?
  spoiler     String?
  createdAt   DateTime
  post        Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment     Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  forumPost   ForumPost? @relation(fields: [forumPostId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Desc)])
  @@index([commentId, createdAt(sort: Desc)])
  @@index([forumPostId, createdAt(sort: Desc)])
}

model Like {
  userId       Int
  likeableType LikeableType
  likeableId   Int
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, likeableType, likeableId])
  @@index([likeableType, likeableId])
}

model Bookmark {
  userId           Int
  bookmarkableType BookmarkableType
  bookmarkableId   Int
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, bookmarkableType, bookmarkableId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([bookmarkableType, bookmarkableId])
}
