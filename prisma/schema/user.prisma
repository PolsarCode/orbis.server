enum Theme {
  system
  light
  dark
}

enum UserStatus {
  online
  idle
  busy
}

enum AuthProvider {
  discord
  twitch
}

model User {
  id                   Int                  @id @default(autoincrement())
  email                String               @unique
  username             String               @unique
  name                 String?
  avatarUrl            String?
  coverUrl             String?
  backgroundUrl        String?
  password             String?
  emailVerifiedAt      DateTime?
  theme                Theme                @default(dark)
  appearOffline        Boolean              @default(false)
  showNsfw             Boolean              @default(false)
  showChangelog        Boolean              @default(true)
  status               UserStatus           @default(online)
  isPublic             Boolean              @default(true)
  isAdmin              Boolean              @default(false)
  isVerified           Boolean              @default(false)
  suspendedAt          DateTime?
  suspendedUntil       DateTime?
  suspensionReason     String?
  suggestionSlots      Int                  @default(10)
  suggestionSlotsAt    DateTime?
  tourCompletedAt      DateTime?
  checklistDismissedAt DateTime?
  completedTours       String[]             @default([])
  createdAt            DateTime             @default(now())
  ownedCommunities     Community[]
  memberships          Membership[]
  posts                Post[]
  wallPosts            Post[]               @relation("WallPosts")
  sentFriendships      Friendship[]         @relation("FriendshipRequester")
  receivedFriendships  Friendship[]         @relation("FriendshipAddressee")
  comments             Comment[]
  reports              Report[]             @relation("ReportAuthor")
  assignedReports      Report[]             @relation("ReportAssignee")
  reportComments       ReportComment[]
  contentReports       ContentReport[]      @relation("ContentReporter")
  resolvedReports      ContentReport[]      @relation("ContentReportResolver")
  notifications        Notification[]       @relation("NotificationRecipient")
  causedNotifications  Notification[]       @relation("NotificationActor")
  libraryEntries       LibraryEntry[]
  steamAccount         SteamAccount?
  steamGames           SteamGame[]
  railFolders          RailFolder[]
  likes                Like[]
  invites              Invite[]
  createdConversations Conversation[]       @relation("ConversationCreator")
  conversationsAsA     Conversation[]       @relation("ConversationUserA")
  conversationsAsB     Conversation[]       @relation("ConversationUserB")
  conversations        ConversationMember[]
  messages             Message[]
  oauthAccounts        OAuthAccount[]
  messageReactions     MessageReaction[]
}

model OAuthAccount {
  id                Int          @id @default(autoincrement())
  userId            Int
  provider          AuthProvider
  providerAccountId String
  username          String
  showLive          Boolean      @default(true)
  showClips         Boolean      @default(true)
  createdAt         DateTime     @default(now())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}
