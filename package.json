{
  "name": "orbis-server",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "setup": "bash ./scripts/development/setup.sh",
    "db:setup": "./scripts/development/database.sh setup",
    "db:start": "./scripts/development/database.sh start",
    "db:stop": "./scripts/development/database.sh stop",
    "db:restart": "./scripts/development/database.sh restart",
    "db:status": "./scripts/development/database.sh status",
    "db:logs": "./scripts/development/database.sh logs",
    "db:remove": "./scripts/development/database.sh remove",
    "storage:setup": "./scripts/development/storage.sh setup",
    "storage:start": "./scripts/development/storage.sh start",
    "storage:stop": "./scripts/development/storage.sh stop",
    "storage:restart": "./scripts/development/storage.sh restart",
    "storage:status": "./scripts/development/storage.sh status",
    "storage:logs": "./scripts/development/storage.sh logs",
    "storage:remove": "./scripts/development/storage.sh remove",
    "storage:bucket": "ts-node -r dotenv/config scripts/development/create-bucket.ts",
    "email:setup": "./scripts/development/email.sh setup",
    "email:start": "./scripts/development/email.sh start",
    "email:stop": "./scripts/development/email.sh stop",
    "email:restart": "./scripts/development/email.sh restart",
    "email:status": "./scripts/development/email.sh status",
    "email:logs": "./scripts/development/email.sh logs",
    "email:remove": "./scripts/development/email.sh remove",
    "dev": "nest start --watch",
    "develop": "pnpm run db:restart && pnpm run storage:restart && pnpm run email:restart && sleep 10 && pnpm run dev",
    "prisma:migrate": "npx prisma migrate dev --name",
    "prisma:generate": "npx prisma generate",
    "prisma:seed": "ts-node -r dotenv/config prisma/seed.ts",
    "prisma:reset": "npx prisma migrate reset --force && pnpm run prisma:seed",
    "prisma:studio": "npx prisma studio",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "deploy": "bash ./scripts/deployment/deploy.sh"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "10.4.22",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "7.0.0",
    "@prisma/client": "7.0.0",
    "@prisma/client-runtime-utils": "7.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.0",
    "sharp": "^0.34.5",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/express": "5.0.5",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.19.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "dotenv": "17.3.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "29.7.0",
    "prettier": "3.8.1",
    "prisma": "7.0.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.21.0",
    "typescript": "5.8.2"
  }
}
